erDiagram
    USUARIO {
        chave identificador
        texto nome
        texto email
        texto papel
        logico ativo
    }

    TURMA {
        chave identificador
        numero ano_letivo
        texto serie
        texto nome
        texto turno
    }

    GRUPO_WHATSAPP {
        chave identificador
        texto nome
        texto link_convite
        logico ativo
    }

    LINK_TURMA {
        chave identificador
        texto titulo
        texto url
        numero ordem
    }

    POST_TURMA {
        chave identificador
        texto titulo
        texto resumo
        texto status
    }

    AVISO {
        chave identificador
        texto titulo
        texto resumo
        texto importancia
        texto status
    }

    IMAGEM_AVISO {
        chave identificador
        texto url
        texto legenda
        numero ordem
    }

    ACERVO {
        chave identificador
        texto ano
        texto categoria
        texto titulo
        texto status
    }

    IMAGEM_ACERVO {
        chave identificador
        texto url
        texto legenda
        numero ordem
    }

    DOCUMENTO {
        chave identificador
        texto titulo
        texto categoria
        texto nome_arquivo
        texto status
    }

    PAGINA_INSTITUCIONAL {
        chave identificador
        texto slug
        texto titulo
        logico publicado
    }

    EVENTO {
        chave identificador
        texto titulo
        texto local
        data data_inicio
        texto status
    }

    REFEICAO {
        chave identificador
        data data
        texto turno
        texto descricao
    }

    NOTIFICACAO {
        chave identificador
        texto titulo
        texto mensagem
        texto importancia
        logico ativa
    }

    USUARIO |o--o{ AVISO : "publica"
    USUARIO |o--o{ ACERVO : "registra"
    USUARIO |o--o{ DOCUMENTO : "disponibiliza"
    USUARIO |o--o{ PAGINA_INSTITUCIONAL : "edita"
    USUARIO |o--o{ POST_TURMA : "publica"
    USUARIO |o--o{ EVENTO : "organiza"

    AVISO ||--o{ IMAGEM_AVISO : "contem"
    ACERVO ||--o{ IMAGEM_ACERVO : "contem"

    TURMA ||--o| GRUPO_WHATSAPP : "possui"
    TURMA ||--o{ LINK_TURMA : "oferece"
    TURMA ||--o{ POST_TURMA : "recebe"

    EVENTO }o--o{ TURMA : "envolve"
